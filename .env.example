# ==========================================
# ASTROMONEY - VARIÁVEIS DE AMBIENTE
# ==========================================

# Porta utilizada pelo servidor.
PORT=3000

# Ambiente da aplicação.
NODE_ENV=development

# Chave da API de notícias.
#
# Crie sua própria chave e configure-a
# no arquivo .env.
#
# NUNCA coloque a chave verdadeira neste arquivo.
NEWS_API_KEY=SUA_CHAVE_DA_NEWSAPI